{
  "name": "@renma/runtime-evidence",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-preserving experiments for agent runtime evidence",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run typecheck && npm test",
    "experiment:codex": "npm run build && node .build/experiments/codex-skill-injected/src/run-experiment.js",
    "experiment:codex:activation-paths": "npm run build && node .build/experiments/codex-skill-activation-paths/src/run-experiment.js",
    "experiment:codex:skill-topology-boundaries": "npm run build && node .build/experiments/codex-skill-topology-boundaries/src/run-experiment.js",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "npm run build && node --test .build/experiments/*/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
